{
  "actions": [],
  "autoname": "hash",
  "doctype": "DocType",
  "engine": "InnoDB",
  "field_order": ["sender", "sender_name", "posted_at", "tag_target", "tagged_user", "message", "mentions"],
  "fields": [
    {"fieldname": "sender", "fieldtype": "Link", "label": "Sent By", "options": "User", "reqd": 1, "in_list_view": 1, "bold": 1, "default": "__user"},
    {"fieldname": "sender_name", "fieldtype": "Data", "label": "Name", "fetch_from": "sender.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "posted_at", "fieldtype": "Datetime", "label": "Posted At", "default": "Now", "read_only": 1, "in_list_view": 1},
    {"fieldname": "tag_target", "fieldtype": "Select", "label": "Tag Audience", "options": "All Staff\nSpecific User", "default": "All Staff", "in_list_view": 1},
    {"fieldname": "tagged_user", "fieldtype": "Link", "label": "Tagged User", "options": "User", "depends_on": "eval:doc.tag_target=='Specific User'", "in_list_view": 1},
    {"fieldname": "message", "fieldtype": "Text Editor", "label": "Message", "reqd": 1},
    {"fieldname": "mentions", "fieldtype": "Small Text", "label": "Notified Users", "read_only": 1}
  ],
  "module": "Instruction Room",
  "name": "Instruction Message",
  "owner": "Administrator",
  "permissions": [
    {"role": "Factory Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Assistant System Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Production Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Store Keeper", "read": 1, "write": 1, "create": 1},
    {"role": "Purchase Manager", "read": 1, "write": 1, "create": 1},
    {"role": "General Staff", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Productix Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Productix Assistant Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Productix Production Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Productix Store Keeper", "read": 1, "write": 1, "create": 1},
    {"role": "Productix Purchase Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Productix General User", "read": 1, "write": 1, "create": 1}
  ],
  "sort_field": "posted_at",
  "sort_order": "DESC",
  "title_field": "sender_name",
  "track_changes": 0
}
