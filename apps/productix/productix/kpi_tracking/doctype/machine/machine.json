{
  "name": "Machine",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:machine_code",
  "field_order": [
    "machine_name", "machine_code", "machine_type",
    "column_break_1", "department", "is_active", "operating_status",
    "section_details", "location", "manufacturer", "model_name",
    "column_break_d1", "serial_number", "installation_date", "description",
    "section_health", "health_score", "health_status", "last_reading_date",
    "column_break_h1", "days_since_maintenance", "last_maintenance_date", "maintenance_frequency_days",
    "section_kpis", "linked_kpis"
  ],
  "fields": [
    {"fieldname": "machine_name", "fieldtype": "Data", "label": "Machine Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "machine_code", "fieldtype": "Data", "label": "Machine Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "machine_type", "fieldtype": "Link", "label": "Machine Type", "options": "Machine Type", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "operating_status", "fieldtype": "Select", "label": "Operating Status",
     "options": "Operational\nIdle\nUnder Maintenance\nDecommissioned", "default": "Operational", "in_list_view": 1},
    {"fieldname": "section_details", "fieldtype": "Section Break", "label": "Details"},
    {"fieldname": "location", "fieldtype": "Data", "label": "Location"},
    {"fieldname": "manufacturer", "fieldtype": "Data", "label": "Manufacturer"},
    {"fieldname": "model_name", "fieldtype": "Data", "label": "Model"},
    {"fieldname": "column_break_d1", "fieldtype": "Column Break"},
    {"fieldname": "serial_number", "fieldtype": "Data", "label": "Serial Number"},
    {"fieldname": "installation_date", "fieldtype": "Date", "label": "Installation Date"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "section_health", "fieldtype": "Section Break", "label": "Health Status"},
    {"fieldname": "health_score", "fieldtype": "Float", "label": "Health Score", "read_only": 1,
     "description": "Auto-calculated from latest readings (0-100)"},
    {"fieldname": "health_status", "fieldtype": "Select", "label": "Health Status", "read_only": 1,
     "options": "\nHealthy\nGood\nWarning\nCritical", "description": "Auto-calculated"},
    {"fieldname": "last_reading_date", "fieldtype": "Date", "label": "Last Reading", "read_only": 1},
    {"fieldname": "column_break_h1", "fieldtype": "Column Break"},
    {"fieldname": "days_since_maintenance", "fieldtype": "Int", "label": "Days Since Maintenance", "read_only": 1},
    {"fieldname": "last_maintenance_date", "fieldtype": "Date", "label": "Last Maintenance Date"},
    {"fieldname": "maintenance_frequency_days", "fieldtype": "Int", "label": "Maintenance Frequency (Days)", "default": "90",
     "description": "Expected maintenance interval in days"},
    {"fieldname": "section_kpis", "fieldtype": "Section Break", "label": "Linked KPIs"},
    {"fieldname": "linked_kpis", "fieldtype": "Table", "label": "Linked KPIs", "options": "Machine KPI Link"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI CEO", "read": 1},
    {"role": "KPI Employee", "read": 1}
  ],
  "sort_field": "machine_name",
  "sort_order": "ASC",
  "title_field": "machine_name",
  "search_fields": "machine_name, machine_code, department, machine_type",
  "track_changes": 1
}
