{
  "name": "KPI Definition",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:kpi_code",
  "fields": [
    {"fieldname": "kpi_name", "fieldtype": "Data", "label": "KPI Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "kpi_code", "fieldtype": "Data", "label": "KPI Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_basic", "fieldtype": "Column Break"},
    {"fieldname": "business_unit", "fieldtype": "Link", "label": "Business Unit", "options": "KPI Business Unit"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "is_customer_level", "fieldtype": "Check", "label": "Customer Level KPI", "default": "0"},
    {"fieldname": "section_desc", "fieldtype": "Section Break"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "section_measurement", "fieldtype": "Section Break", "label": "Measurement"},
    {"fieldname": "measurement_type", "fieldtype": "Select", "label": "Measurement Type", "reqd": 1, "options": "Number\nInteger\nDecimal\nPercentage\nCurrency\nDuration\nRating", "default": "Number"},
    {"fieldname": "unit", "fieldtype": "Data", "label": "Unit"},
    {"fieldname": "direction", "fieldtype": "Select", "label": "Direction", "options": "Higher is Better\nLower is Better\nTarget Range\nExact Target", "default": "Higher is Better"},
    {"fieldname": "column_break_m1", "fieldtype": "Column Break"},
    {"fieldname": "allow_negative", "fieldtype": "Check", "label": "Allow Negative", "default": "0"},
    {"fieldname": "decimal_precision", "fieldtype": "Int", "label": "Decimal Precision", "default": "2"},
    {"fieldname": "section_source", "fieldtype": "Section Break", "label": "Data Source"},
    {"fieldname": "source_type", "fieldtype": "Select", "label": "Source Type", "options": "Manual\nFormula\nVariable\nERPNext", "default": "Manual"},
    {"fieldname": "formula", "fieldtype": "Link", "label": "Formula", "options": "KPI Formula", "depends_on": "eval:doc.source_type=='Formula'"},
    {"fieldname": "column_break_s1", "fieldtype": "Column Break"},
    {"fieldname": "source_variable", "fieldtype": "Link", "label": "Source Variable", "options": "KPI Variable", "depends_on": "eval:doc.source_type=='Variable'"},
    {"fieldname": "operational_table", "fieldtype": "Link", "label": "Operational Table", "options": "KPI Operational Table"},
    {"fieldname": "section_target", "fieldtype": "Section Break", "label": "Target"},
    {"fieldname": "target_type", "fieldtype": "Select", "label": "Target Type", "options": "Fixed Target\nGrowth Target\nRange\nNo Target", "default": "Fixed Target"},
    {"fieldname": "target_value", "fieldtype": "Float", "label": "Target Value"},
    {"fieldname": "column_break_t1", "fieldtype": "Column Break"},
    {"fieldname": "minimum_acceptable", "fieldtype": "Float", "label": "Minimum Acceptable"},
    {"fieldname": "warning_threshold", "fieldtype": "Float", "label": "Warning Threshold %", "default": "80", "description": "Achievement % below this triggers Warning"},
    {"fieldname": "critical_threshold", "fieldtype": "Float", "label": "Critical Threshold %", "default": "60", "description": "Achievement % below this triggers Critical"},
    {"fieldname": "section_frequency", "fieldtype": "Section Break", "label": "Frequency"},
    {"fieldname": "frequency", "fieldtype": "Select", "label": "Frequency", "reqd": 1, "options": "Daily\nWeekly\nMonthly\nQuarterly\nYearly", "default": "Daily"},
    {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date"},
    {"fieldname": "section_analytics", "fieldtype": "Section Break", "label": "Analytics"},
    {"fieldname": "prediction_enabled", "fieldtype": "Check", "label": "Enable Prediction", "default": "1"},
    {"fieldname": "trend_method", "fieldtype": "Select", "label": "Trend Method", "options": "Linear\nMoving Average\nWeighted", "default": "Linear"},
    {"fieldname": "column_break_an1", "fieldtype": "Column Break"},
    {"fieldname": "growth_method", "fieldtype": "Select", "label": "Growth Method", "options": "Period over Period\nYear over Year", "default": "Period over Period"},
    {"fieldname": "section_alerts", "fieldtype": "Section Break", "label": "Alerts"},
    {"fieldname": "alert_enabled", "fieldtype": "Check", "label": "Enable Alerts", "default": "1"},
    {"fieldname": "alert_target_miss", "fieldtype": "Check", "label": "Alert on Target Miss", "default": "1"},
    {"fieldname": "alert_negative_trend", "fieldtype": "Check", "label": "Alert on Negative Trend", "default": "1"},
    {"fieldname": "column_break_al1", "fieldtype": "Column Break"},
    {"fieldname": "alert_growth_decline", "fieldtype": "Check", "label": "Alert on Growth Decline", "default": "1"},
    {"fieldname": "alert_prediction_miss", "fieldtype": "Check", "label": "Alert on Prediction Miss", "default": "1"},
    {"fieldname": "alert_repeated_decline", "fieldtype": "Check", "label": "Alert on Repeated Decline", "default": "1"},
    {"fieldname": "section_ownership", "fieldtype": "Section Break", "label": "Ownership"},
    {"fieldname": "kpi_owner", "fieldtype": "Link", "label": "KPI Owner", "options": "User"},
    {"fieldname": "weight", "fieldtype": "Float", "label": "Weight", "default": "1.0"},
    {"fieldname": "section_inputs", "fieldtype": "Section Break", "label": "Input Fields", "description": "Define what data users need to enter for this KPI"},
    {"fieldname": "kpi_inputs", "fieldtype": "Table", "label": "Input Fields", "options": "KPI Input Definition"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "kpi_name",
  "sort_order": "ASC",
  "title_field": "kpi_name",
  "search_fields": "kpi_name, kpi_code, department",
  "track_changes": 1
}
