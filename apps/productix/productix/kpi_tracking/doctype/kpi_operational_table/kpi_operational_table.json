{
  "name": "KPI Operational Table",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:table_code",
  "fields": [
    {"fieldname": "table_name", "fieldtype": "Data", "label": "Table Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "table_code", "fieldtype": "Data", "label": "Table Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "business_unit", "fieldtype": "Link", "label": "Business Unit", "options": "KPI Business Unit"},
    {"fieldname": "location", "fieldtype": "Data", "label": "Location"},
    {"fieldname": "location_type", "fieldtype": "Select", "label": "Location Type", "options": "\nUrban\nRural\nIndustrial\nRegional\nWarehouse\nFactory\nOffice\nOther"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1"},
    {"fieldname": "section_desc", "fieldtype": "Section Break"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "section_variables", "fieldtype": "Section Break", "label": "Variables / Indicators"},
    {"fieldname": "variables", "fieldtype": "Table", "label": "Variables", "options": "KPI Operational Table Variable"},
    {"fieldname": "section_customers", "fieldtype": "Section Break", "label": "Customers"},
    {"fieldname": "customers", "fieldtype": "Table", "label": "Customers", "options": "KPI Operational Table Customer"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "table_name",
  "sort_order": "ASC",
  "title_field": "table_name",
  "search_fields": "table_name, table_code, department",
  "track_changes": 1
}
