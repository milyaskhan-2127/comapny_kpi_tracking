{
  "name": "KPI CEO Access",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "Expression (old style)",
  "autoname": "KPI-CEO-.#####",
  "field_order": [
    "user", "user_full_name", "is_active",
    "column_break_1", "access_scope", "can_view_company_overview", "can_view_machines",
    "section_departments", "department_access",
    "section_kpi_access", "kpi_access"
  ],
  "fields": [
    {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "in_list_view": 1, "unique": 0},
    {"fieldname": "user_full_name", "fieldtype": "Data", "label": "Full Name", "fetch_from": "user.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "access_scope", "fieldtype": "Select", "label": "Access Scope",
     "options": "All Departments\nSelected Departments Only",
     "default": "All Departments", "reqd": 1, "in_list_view": 1,
     "description": "Controls which departments this CEO can access"},
    {"fieldname": "can_view_company_overview", "fieldtype": "Check", "label": "Can View Company Overview", "default": "1"},
    {"fieldname": "can_view_machines", "fieldtype": "Check", "label": "Can View Machine Health", "default": "1"},
    {"fieldname": "section_departments", "fieldtype": "Section Break", "label": "Department Access",
     "depends_on": "eval:doc.access_scope=='Selected Departments Only'"},
    {"fieldname": "department_access", "fieldtype": "Table", "label": "Department Access",
     "options": "KPI CEO Department Access",
     "depends_on": "eval:doc.access_scope=='Selected Departments Only'"},
    {"fieldname": "section_kpi_access", "fieldtype": "Section Break", "label": "Specific KPI Access",
     "description": "When a department has 'View Specific KPIs' access level, only the KPIs listed here are visible"},
    {"fieldname": "kpi_access", "fieldtype": "Table", "label": "KPI Access",
     "options": "KPI CEO KPI Access"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "user",
  "sort_order": "ASC",
  "title_field": "user_full_name",
  "search_fields": "user, user_full_name",
  "track_changes": 1
}
