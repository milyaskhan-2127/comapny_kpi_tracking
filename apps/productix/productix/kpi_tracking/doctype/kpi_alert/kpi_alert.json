{
  "name": "KPI Alert",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression (old style)",
  "autoname": "KPI-ALERT-.YYYY.-.MM.-.#####",
  "fields": [
    {"fieldname": "alert_type", "fieldtype": "Select", "label": "Alert Type", "reqd": 1, "options": "Target Miss\nGrowth Decline\nNegative Trend\nPrediction Miss\nRepeated Decline\nAdmin Directive\nEmployee Escalation\nMissing Data Reminder\nMachine Health Critical\nMachine Maintenance Overdue\nMachine Data Stale", "in_list_view": 1},
    {"fieldname": "subject", "fieldtype": "Data", "label": "Subject", "in_list_view": 1},
    {"fieldname": "severity", "fieldtype": "Select", "label": "Severity", "reqd": 1, "options": "Info\nWarning\nCritical\nInformational", "default": "Info", "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nAcknowledged\nResolved", "default": "Active", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 0, "in_list_view": 1},
    {"fieldname": "kpi", "fieldtype": "Link", "label": "KPI", "options": "KPI Definition", "reqd": 0, "in_list_view": 1},
    {"fieldname": "trigger_period", "fieldtype": "Data", "label": "Trigger Period"},
    {"fieldname": "section_details", "fieldtype": "Section Break", "label": "Details"},
    {"fieldname": "message", "fieldtype": "Text", "label": "Message", "reqd": 1},
    {"fieldname": "column_break_d1", "fieldtype": "Column Break"},
    {"fieldname": "trigger_value", "fieldtype": "Float", "label": "Trigger Value"},
    {"fieldname": "threshold_value", "fieldtype": "Float", "label": "Threshold Value"},
    {"fieldname": "section_sender", "fieldtype": "Section Break", "label": "Sender Information"},
    {"fieldname": "sender", "fieldtype": "Link", "label": "Sender", "options": "User", "read_only": 1},
    {"fieldname": "sender_name", "fieldtype": "Data", "label": "Sender Name", "read_only": 1},
    {"fieldname": "sender_role", "fieldtype": "Data", "label": "Sender Role", "read_only": 1},
    {"fieldname": "section_resolution", "fieldtype": "Section Break", "label": "Resolution"},
    {"fieldname": "resolved_at", "fieldtype": "Datetime", "label": "Resolved At", "read_only": 1},
    {"fieldname": "resolved_by", "fieldtype": "Link", "label": "Resolved By", "options": "User", "read_only": 1},
    {"fieldname": "cooldown_until", "fieldtype": "Datetime", "label": "Cooldown Until", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI CEO", "read": 1, "write": 1},
    {"role": "KPI Manager", "read": 1, "write": 1},
    {"role": "KPI Employee", "read": 1, "write": 1},
    {"role": "KPI Contributor", "read": 1, "write": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "title_field": "subject",
  "search_fields": "kpi, department, alert_type, severity, status, sender_name, subject",
  "track_changes": 1
}
