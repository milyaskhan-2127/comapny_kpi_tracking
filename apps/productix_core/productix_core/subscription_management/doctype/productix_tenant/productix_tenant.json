{
  "autoname": "field:tenant_name",
  "doctype": "DocType",
  "engine": "InnoDB",
  "fields": [
    {"fieldname": "tenant_name", "fieldtype": "Data", "label": "Company / Tenant Name", "reqd": 1, "bold": 1, "in_list_view": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "license", "fieldtype": "Link", "label": "Active License", "options": "Productix License"},
    {"fieldname": "admin_user", "fieldtype": "Link", "label": "Admin User", "options": "User"},
    {"fieldname": "created_on", "fieldtype": "Date", "label": "Created On", "default": "Today", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "module": "Subscription Management",
  "name": "Productix Tenant",
  "naming_rule": "By fieldname",
  "owner": "Administrator",
  "permissions": [
    {"role": "Factory Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Assistant System Administrator", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Productix Admin", "read": 1}
  ],
  "title_field": "tenant_name"
}
