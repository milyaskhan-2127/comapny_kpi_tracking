{
  "doctype": "DocType",
  "engine": "InnoDB",
  "field_order": ["extra_name","ingredient","ingredient_name","base_quantity","portion_multiplier","quantity","unit"],
  "fields": [
    {"fieldname": "extra_name", "fieldtype": "Data", "label": "Extra", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "ingredient", "fieldtype": "Link", "label": "Ingredient", "options": "Item", "in_list_view": 1},
    {"fieldname": "ingredient_name", "fieldtype": "Data", "label": "Ingredient Name", "fetch_from": "ingredient.item_name", "read_only": 1},
    {"fieldname": "base_quantity", "fieldtype": "Float", "label": "Base Qty"},
    {"fieldname": "portion_multiplier", "fieldtype": "Select", "label": "Portion", "options": "1x\n2x\n3x", "default": "1x", "in_list_view": 1},
    {"fieldname": "quantity", "fieldtype": "Float", "label": "Total Qty", "read_only": 1, "in_list_view": 1},
    {"fieldname": "unit", "fieldtype": "Link", "label": "UOM", "options": "UOM", "read_only": 1}
  ],
  "istable": 1,
  "module": "Recipe Management",
  "name": "Production Order Extra",
  "owner": "Administrator"
}
