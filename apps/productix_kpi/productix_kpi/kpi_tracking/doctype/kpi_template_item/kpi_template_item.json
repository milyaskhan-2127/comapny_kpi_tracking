{
  "name": "KPI Template Item",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "",
  "engine": "InnoDB",
  "istable": 1,
  "fields": [
    {"fieldname": "kpi_name", "fieldtype": "Data", "label": "KPI Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "measurement_type", "fieldtype": "Select", "label": "Measurement Type", "reqd": 1, "options": "Number\nInteger\nDecimal\nPercentage\nCurrency\nDuration\nRating", "default": "Number", "in_list_view": 1},
    {"fieldname": "default_target", "fieldtype": "Float", "label": "Default Target", "in_list_view": 1},
    {"fieldname": "default_frequency", "fieldtype": "Select", "label": "Frequency", "options": "Daily\nWeekly\nMonthly", "default": "Daily", "in_list_view": 1},
    {"fieldname": "direction", "fieldtype": "Select", "label": "Direction", "options": "Higher is Better\nLower is Better\nTarget Range\nExact Target", "default": "Higher is Better"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"}
  ],
  "permissions": []
}
