{
  "name": "KPI Operational Data",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "is_submittable": 1,
  "naming_rule": "Expression (old style)",
  "autoname": "KPI-OPS-.YYYY.-.MM.-.#####",
  "fields": [
    {"fieldname": "operational_table", "fieldtype": "Link", "label": "Operational Table", "options": "KPI Operational Table", "reqd": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "business_unit", "fieldtype": "Link", "label": "Business Unit", "options": "KPI Business Unit"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "entry_date", "fieldtype": "Date", "label": "Entry Date", "reqd": 1, "default": "Today", "in_list_view": 1},
    {"fieldname": "period", "fieldtype": "Data", "label": "Period", "read_only": 1},
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer"},
    {"fieldname": "section_values", "fieldtype": "Section Break", "label": "Values"},
    {"fieldname": "values", "fieldtype": "Table", "label": "Values", "options": "KPI Operational Data Value"},
    {"fieldname": "section_audit", "fieldtype": "Section Break", "label": "Audit"},
    {"fieldname": "entered_by", "fieldtype": "Link", "label": "Entered By", "options": "User", "read_only": 1, "default": "__user"},
    {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "KPI Operational Data", "read_only": 1, "no_copy": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1}
  ],
  "sort_field": "entry_date",
  "sort_order": "DESC",
  "title_field": "operational_table",
  "search_fields": "operational_table, department, period",
  "track_changes": 1
}
