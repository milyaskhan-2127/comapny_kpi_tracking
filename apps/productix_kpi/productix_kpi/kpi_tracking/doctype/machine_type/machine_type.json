{
  "name": "Machine Type",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:type_code",
  "field_order": [
    "type_name", "type_code", "column_break_1", "is_active", "description",
    "section_parameters", "parameters"
  ],
  "fields": [
    {"fieldname": "type_name", "fieldtype": "Data", "label": "Type Name", "reqd": 1, "in_list_view": 1,
     "description": "e.g. Motor, CNC Machine, Pump, Compressor"},
    {"fieldname": "type_code", "fieldtype": "Data", "label": "Type Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "section_parameters", "fieldtype": "Section Break", "label": "Monitoring Parameters",
     "description": "Define which parameters should be monitored for machines of this type"},
    {"fieldname": "parameters", "fieldtype": "Table", "label": "Parameters", "options": "Machine Type Parameter", "reqd": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI CEO", "read": 1},
    {"role": "KPI Employee", "read": 1}
  ],
  "sort_field": "type_name",
  "sort_order": "ASC",
  "title_field": "type_name",
  "search_fields": "type_name, type_code",
  "track_changes": 1
}
