{
  "name": "KPI Business Unit",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:unit_code",
  "fields": [
    {"fieldname": "unit_name", "fieldtype": "Data", "label": "Unit Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "unit_code", "fieldtype": "Data", "label": "Unit Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "location", "fieldtype": "Data", "label": "Location"},
    {"fieldname": "location_type", "fieldtype": "Select", "label": "Location Type", "options": "\nUrban\nRural\nIndustrial\nRegional\nWarehouse\nFactory\nOffice\nOther"},
    {"fieldname": "region", "fieldtype": "Data", "label": "Region"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "section_break_2", "fieldtype": "Section Break"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "unit_name",
  "sort_order": "ASC",
  "title_field": "unit_name",
  "search_fields": "unit_name, unit_code, location",
  "track_changes": 1
}
