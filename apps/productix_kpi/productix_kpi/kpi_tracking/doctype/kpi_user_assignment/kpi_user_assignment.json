{
  "name": "KPI User Assignment",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "Expression (old style)",
  "autoname": "KPI-USER-.#####",
  "fields": [
    {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "role", "fieldtype": "Select", "label": "Role", "reqd": 1, "options": "Admin\nEmployee\nKPI Admin\nKPI Employee\nKPI Manager\nKPI Contributor", "default": "Employee", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "business_unit", "fieldtype": "Link", "label": "Business Unit", "options": "KPI Business Unit"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "user",
  "sort_order": "ASC",
  "title_field": "user",
  "search_fields": "user, department, role",
  "track_changes": 1
}
