{
  "name": "KPI Data Entry",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "is_submittable": 1,
  "naming_rule": "Expression (old style)",
  "autoname": "KPI-DATA-.YYYY.-.MM.-.#####",
  "fields": [
    {"fieldname": "kpi", "fieldtype": "Link", "label": "KPI", "options": "KPI Definition", "reqd": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "business_unit", "fieldtype": "Link", "label": "Business Unit", "options": "KPI Business Unit"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "entry_date", "fieldtype": "Date", "label": "Entry Date", "reqd": 1, "default": "Today", "in_list_view": 1},
    {"fieldname": "period", "fieldtype": "Data", "label": "Period", "read_only": 1, "in_list_view": 1},
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer"},
    {"fieldname": "section_values", "fieldtype": "Section Break", "label": "Values"},
    {"fieldname": "actual_value", "fieldtype": "Float", "label": "Actual Value", "reqd": 1, "in_list_view": 1},
    {"fieldname": "target_value", "fieldtype": "Float", "label": "Target Value", "read_only": 1},
    {"fieldname": "column_break_v1", "fieldtype": "Column Break"},
    {"fieldname": "achievement_percentage", "fieldtype": "Percent", "label": "Achievement %", "read_only": 1},
    {"fieldname": "normalized_score", "fieldtype": "Float", "label": "Normalized Score (0-100)", "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "\nOn Track\nWarning\nCritical\nMissing Data", "read_only": 1, "in_list_view": 1},
    {"fieldname": "section_inputs", "fieldtype": "Section Break", "label": "Input Values", "collapsible": 1},
    {"fieldname": "input_values", "fieldtype": "Table", "label": "Input Values", "options": "KPI Data Entry Value"},
    {"fieldname": "section_audit", "fieldtype": "Section Break", "label": "Audit"},
    {"fieldname": "entered_by", "fieldtype": "Link", "label": "Entered By", "options": "User", "read_only": 1, "default": "__user"},
    {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "KPI Data Entry", "read_only": 1, "no_copy": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "KPI CEO", "read": 1},
    {"role": "KPI Employee", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "KPI Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "KPI Contributor", "read": 1, "write": 1, "create": 1, "submit": 1}
  ],
  "sort_field": "entry_date",
  "sort_order": "DESC",
  "title_field": "kpi",
  "search_fields": "kpi, department, period",
  "track_changes": 1
}
