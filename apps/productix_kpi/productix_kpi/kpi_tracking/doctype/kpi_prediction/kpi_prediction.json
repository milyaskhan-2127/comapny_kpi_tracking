{
  "name": "KPI Prediction",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression (old style)",
  "autoname": "KPI-PRED-.YYYY.-.MM.-.#####",
  "fields": [
    {"fieldname": "kpi", "fieldtype": "Link", "label": "KPI", "options": "KPI Definition", "reqd": 1, "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "reqd": 1, "in_list_view": 1},
    {"fieldname": "prediction_date", "fieldtype": "Date", "label": "Prediction Date", "reqd": 1, "default": "Today"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "target_period", "fieldtype": "Data", "label": "Target Period", "reqd": 1, "in_list_view": 1},
    {"fieldname": "prediction_method", "fieldtype": "Data", "label": "Prediction Method", "default": "Linear Regression"},
    {"fieldname": "data_points_used", "fieldtype": "Int", "label": "Data Points Used"},
    {"fieldname": "section_values", "fieldtype": "Section Break", "label": "Values"},
    {"fieldname": "predicted_value", "fieldtype": "Float", "label": "Predicted Value", "reqd": 1, "in_list_view": 1},
    {"fieldname": "actual_value", "fieldtype": "Float", "label": "Actual Value"},
    {"fieldname": "column_break_v1", "fieldtype": "Column Break"},
    {"fieldname": "variance", "fieldtype": "Float", "label": "Variance", "read_only": 1},
    {"fieldname": "variance_percentage", "fieldtype": "Percent", "label": "Variance %", "read_only": 1},
    {"fieldname": "accuracy", "fieldtype": "Percent", "label": "Accuracy %", "read_only": 1},
    {"fieldname": "section_status", "fieldtype": "Section Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nMatched\nPrediction Miss\nInsufficient Data", "default": "Pending", "in_list_view": 1},
    {"fieldname": "confidence", "fieldtype": "Percent", "label": "Confidence"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "prediction_date",
  "sort_order": "DESC",
  "title_field": "kpi",
  "search_fields": "kpi, department, target_period, status",
  "track_changes": 1
}
