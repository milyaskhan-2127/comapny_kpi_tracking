{
  "name": "KPI Template",
  "module": "KPI Tracking",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:template_code",
  "fields": [
    {"fieldname": "template_name", "fieldtype": "Data", "label": "Template Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "template_code", "fieldtype": "Data", "label": "Template Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "KPI Department", "in_list_view": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1"},
    {"fieldname": "section_desc", "fieldtype": "Section Break"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "section_items", "fieldtype": "Section Break", "label": "KPI Items"},
    {"fieldname": "items", "fieldtype": "Table", "label": "KPI Items", "options": "KPI Template Item"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "KPI Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "template_name",
  "sort_order": "ASC",
  "title_field": "template_name",
  "search_fields": "template_name, template_code",
  "track_changes": 1
}
