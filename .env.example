# ============================================================================
# Productix ERP — Environment Variable Reference
# ============================================================================
# Copy this file to `.env` (git-ignored) and fill in real values.
#   On Windows:    Copy-Item .env.example .env
#   On Linux/mac:  cp .env.example .env
#
# Productix never hard-codes secrets. All credentials are read from the
# environment at runtime (see productix_core.utils.email_utils and
# productix_kpi.kpi_tracking.services.groq_ai).
#
# NOTE ON GIT HISTORY: the original monolithic repo committed an SMTP password
# in earlier revisions. The history has since been rewritten (git filter-repo)
# and the working tree is scrubbed. Rotate the SMTP password before using the
# mail account elsewhere.
# ============================================================================

# ----------------------------------------------------------------------------
# Deployment (REQUIRED on a fresh host)
# The stack will not come up without these — the configurator refuses to
# start and tells you exactly what is missing instead of restart-looping.
# CHANGE BOTH before exposing this to a network.
# ----------------------------------------------------------------------------
SITE_NAME=productix.local
MARIADB_ROOT_PASSWORD=change_me_strong_password_123
ADMIN_PASSWORD=Admin@123

# ----------------------------------------------------------------------------
# Frontend boot readiness (optional - the defaults are right for most hosts)
#
# On a FIRST boot the backend spends minutes on new-site -> build -> migrate
# before gunicorn binds :8000, and compose's short-form `depends_on` only
# waits for the container to START, not for it to serve. Without a gate, nginx
# comes up in that window and every request is a 502 that looks exactly like a
# broken proxy.
#
# docker/frontend-entrypoint.sh therefore probes the backend first (the same
# ping-with-Host request the healthcheck makes) and holds nginx back. If the
# backend never answers within this many seconds it starts nginx ANYWAY, with
# a warning: from then on a dead backend returns 503 + Retry-After and a page
# that reloads itself, instead of 502.
#
#   0 (or a non-number) = no wait, start nginx immediately
#
# FRONTEND_BACKEND_WAIT_SECONDS=300
# FRONTEND_BACKEND_PROBE_PATH=/api/method/ping
# FRONTEND_BACKEND_PROBE_INTERVAL=2
# FRONTEND_WARMING_DIR=/tmp/productix-warming

# ----------------------------------------------------------------------------
# Module selection (optional) - which productix apps get INSTALLED. There is
# NO default combination: the platform is modular and every deployment picks
# its own set.
#
#   (a) unset / empty  -> install EVERY app discovered from
#                         apps/*/productix_*/productix_module.json
#                         (development mode: you get the whole platform)
#   (b) comma list     -> install ONLY those apps; anything else in apps/ is
#                         mounted but left uninstalled (inert)
#
# In both cases the platform app (manifest flagged "always_enabled", today
# productix_core) is installed first - it can never be omitted. Dependencies
# declared in each manifest's "requires" are added automatically, transitively
# and ahead of the module that needs them. A `requires` entry naming a
# productix module that is not in apps/ is reported loudly at start-up;
# frappe and erpnext are the bench base, are installed unconditionally, and
# are never part of a module selection.
#
# This ONE variable drives every path, because they all resolve it with the
# same rules (docker/productix-selection.sh, mirrored for Windows by
# docker/productix-selection.ps1):
#
#     .env  ->  docker compose up            (backend-entrypoint.sh)
#           ->  setup_site.sh / setup_site.ps1   (initial setup)
#           ->  deploy.sh   / deploy.ps1         (update)
#
# Every one of them also READS this file, so PRODUCTIX_APPS here is honoured
# whether you start the stack, set up a site manually, or run an update. An
# exported variable still beats the file for a single run:
#
#     PRODUCTIX_APPS=productix_core ./setup_site.sh
#
# On EVERY start the selection is reconciled against the site's database:
#
#     selected but not installed  -> installed, then migrate + build
#     installed but not selected  -> reported, NEVER uninstalled (dropping a
#                                    module drops its tables with it); remove
#                                    it by hand if that is really wanted
#
# and the result is printed as a "module status" block just before gunicorn,
# so a mismatch is visible without digging a dead container's log out.
#
# Change a value here, then bring the stack up again with
# `docker compose up -d` - a plain `docker compose restart` re-uses the
# container that was created, so it carries the OLD values of this file.
#
# post_install hooks (a module can declare one in its manifest) run only
# while a site is being created. They re-seed data, so a module added to a
# site that already finished installing is installed without its hook, and
# the start-up log prints the exact command to run it yourself.
#
# All of the following are equally valid - pick per deployment:
#   (a) all apps:
#          (leave PRODUCTIX_APPS unset or commented out)
#   (b) platform only:
#          PRODUCTIX_APPS=productix_core
#   (c) platform + recipe:
#          PRODUCTIX_APPS=productix_core,productix_recipe
#   (d) platform + KPI:
#          PRODUCTIX_APPS=productix_core,productix_kpi
#   (e) platform + recipe + KPI + instruction = same as (a):
#          PRODUCTIX_APPS=productix_core,productix_recipe,productix_kpi,productix_instruction
# ----------------------------------------------------------------------------
# PRODUCTIX_APPS=

# ----------------------------------------------------------------------------
# SMTP / outgoing email (productix_core)
# The Email Account is created/updated ONLY when MAIL_PASSWORD is set.
# Without it, setup skips SMTP provisioning with a warning — no placeholder
# credentials are ever written to the database.
# ----------------------------------------------------------------------------
MAIL_SERVER=mail.techohub.net
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=support@techohub.net
# REQUIRED for outgoing email to be provisioned:
# MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="Productix ERP <support@techohub.net>"

# ----------------------------------------------------------------------------
# Groq AI (productix_kpi — KPI AI Assistant / predictions)
# Either this env var OR site config key `groq_api_key` (bench set-config).
# ----------------------------------------------------------------------------
# GROQ_API_KEY=

# ----------------------------------------------------------------------------
# Docker Compose stack (optional overrides — defaults in docker-compose.yml)
# ----------------------------------------------------------------------------
# DB_HOST=mariadb
# DB_PORT=3306
# REDIS_CACHE=redis-cache:6379
# REDIS_QUEUE=redis-queue:6379
# SOCKETIO_PORT=9000