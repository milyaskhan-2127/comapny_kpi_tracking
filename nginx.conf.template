# Productix ERP — Nginx config template.
#
# Every placeholder written as an UPPER_CASE token in double underscores is
# replaced at container start by docker/frontend-entrypoint.sh (see
# docker-compose.yml frontend service). The token, and the value it becomes:
#
#   SITE_NAME          -> NGINX_SITE_NAME / FRAPPE_SITE_NAME_HEADER
#   BACKEND_UPSTREAM   -> BACKEND   (the same value the readiness gate probes)
#   SOCKETIO_UPSTREAM  -> SOCKETIO
#   WARMING_DIR        -> directory holding the "starting up" page
#
# Nothing is hard-coded: no site name, and no upstream address either. The
# entrypoint refuses to start if a placeholder survives substitution, so nginx
# can never silently proxy to a literal upstream token.

server {
	listen 8080 default_server;
	server_name __SITE_NAME__ _;
	root /home/frappe/frappe-bench/sites;

	# Upstreams are resolved PER REQUEST, never at config-load time.
	#
	# An `upstream { server backend:8000; }` block is resolved exactly once,
	# when nginx reads its config. Docker hands a recreated container a new IP,
	# so after a backend-only `docker compose up -d` this nginx would keep
	# proxying to a dead address and every dynamic route would 502 until someone
	# restarted the frontend by hand - the opposite of a no-manual-steps boot.
	# Routing through a variable defers the lookup to request time via Docker's
	# embedded DNS, so a recreated backend is picked up on its own (at most
	# `valid=` later). It also removes the startup-time resolution, so nginx no
	# longer needs `backend` / `websocket` to be resolvable while it boots -
	# container start order cannot break it either.
	resolver 127.0.0.11 valid=5s ipv6=off;
	set $backend_upstream __BACKEND_UPSTREAM__;
	set $socketio_upstream __SOCKETIO_UPSTREAM__;

	# Net for a backend that is not listening (first boot, or one that dies
	# later): turn the bare 502/504 into a 503 with Retry-After and a page that
	# reloads itself, instead of a dead end that reads as a broken proxy.
	# Only connection-level failures reach this - proxy_intercept_errors stays
	# off, so an error the APPLICATION returns is passed through untouched.
	error_page 502 504 =503 /_warming_up;

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	add_header X-Frame-Options "SAMEORIGIN";
	add_header X-Content-Type-Options nosniff;
	add_header X-XSS-Protection "1; mode=block";

	set_real_ip_from 127.0.0.1;
	real_ip_header X-Forwarded-For;
	real_ip_recursive off;

	location /assets {
		try_files $uri =404;
	}

	# Served ONLY through the error_page above (internal redirect), so this URL
	# is never reachable on its own and cannot expose anything real.
	location = /_warming_up {
		internal;
		root __WARMING_DIR__;
		try_files /index.html =503;
		# `always` is required: 503 is not in add_header's default status list.
		add_header Retry-After 5 always;
		add_header Cache-Control "no-store" always;
	}

	location ~ ^/protected/(.*) {
		internal;
		try_files /__SITE_NAME__/$1 =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name __SITE_NAME__;
		proxy_set_header Origin $scheme://__SITE_NAME__;
		proxy_set_header Host $host;

		proxy_pass http://$socketio_upstream;
	}

	location / {
		# Handle CORS preflight
		if ($request_method = 'OPTIONS') {
			add_header 'Access-Control-Allow-Origin' '$http_origin' always;
			add_header 'Access-Control-Allow-Credentials' 'true' always;
			add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE' always;
			add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Frappe-CSRF-Token' always;
			add_header 'Access-Control-Max-Age' 1728000;
			add_header 'Content-Type' 'text/plain; charset=utf-8';
			add_header 'Content-Length' 0;
			return 204;
		}

		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		location ~ ^/files/.*.(htm|html|svg|xml) {
			add_header Content-disposition "attachment";
			try_files /__SITE_NAME__/public/$uri @webserver;
		}

		try_files /__SITE_NAME__/public/$uri @webserver;
	}

	location @webserver {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Frappe-Site-Name __SITE_NAME__;
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout 120;
		proxy_redirect off;

		proxy_pass http://$backend_upstream;
	}

	sendfile on;
	keepalive_timeout 15;
	client_max_body_size 50m;
	client_body_buffer_size 16K;
	client_header_buffer_size 1k;

	gzip on;
	gzip_http_version 1.1;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/atom+xml
		application/javascript
		application/json
		application/rss+xml
		application/vnd.ms-fontobject
		application/x-font-ttf
		application/font-woff
		application/x-web-app-manifest+json
		application/xhtml+xml
		application/xml
		font/opentype
		image/svg+xml
		image/x-icon
		text/css
		text/plain
		text/x-component;
}